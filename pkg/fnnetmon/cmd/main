#!/bin/bash
# fnnetmon 生命周期：start / stop / status

BIN="${TRIM_APPDEST}/bin/fnnetmon"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/server.log"
SOCK="${TRIM_APPDEST}/app.sock"
PORT="${TRIM_SERVICE_PORT:-18089}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "${LOG_FILE}"
}

is_running() {
    [ -r "${PID_FILE}" ] || return 1
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null
}

start_process() {
    if is_running; then
        log_msg "already running, skip"
        return 0
    fi
    mkdir -p "${TRIM_PKGVAR}" "${TRIM_PKGETC}"
    chmod +x "${BIN}" 2>/dev/null

    # 日志轮转：服务是长期跑的，日志只追加不轮转会慢慢吃满分区。
    # 5MB 对这台设备已经足够存几个月的错误记录，超过就换一份。
    if [ -f "${LOG_FILE}" ]; then
        size=$(wc -c < "${LOG_FILE}" 2>/dev/null || echo 0)
        if [ "${size}" -gt 5242880 ]; then
            mv -f "${LOG_FILE}" "${LOG_FILE}.1" 2>/dev/null
            log_msg "log rotated (previous ${size} bytes)"
        fi
    fi

    log_msg "starting: ${BIN} serve --sock ${SOCK} --addr 0.0.0.0:${PORT}"
    nohup setsid "${BIN}" serve \
        --sock "${SOCK}" \
        --addr "0.0.0.0:${PORT}" \
        --var "${TRIM_PKGVAR}" >> "${LOG_FILE}" 2>&1 &

    echo $! > "${PID_FILE}"
    sleep 1
    if is_running; then
        log_msg "started pid=$(cat ${PID_FILE})"
        return 0
    fi
    log_msg "start failed, see ${LOG_FILE}"
    echo "流量哨兵启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
    return 1
}

stop_process() {
    log_msg "stopping"
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            kill -TERM "${pid}" 2>/dev/null
            for i in $(seq 1 10); do
                kill -0 "${pid}" 2>/dev/null || break
                sleep 1
            done
            kill -0 "${pid}" 2>/dev/null && kill -KILL "${pid}" 2>/dev/null
        fi
        rm -f "${PID_FILE}"
    fi
    pkill -f "fnnetmon serve" 2>/dev/null
    rm -f "${SOCK}"

    # 兜底：进程被 KILL 掉时来不及自己清规则，这里补一刀。
    # 服务不跑了，出向拦截就不该继续生效——否则用户既上不了网，也找不到地方关。
    if [ -x "${BIN}" ]; then
        "${BIN}" firewall off --var "${TRIM_PKGVAR}" >> "${LOG_FILE}" 2>&1
    fi
    return 0
}

case "$1" in
    start)   start_process ;;
    stop)    stop_process ;;
    status)  if is_running; then exit 0; else exit 3; fi ;;
    *)       echo "unknown: $1" > "${TRIM_TEMP_LOGFILE}"; exit 1 ;;
esac
